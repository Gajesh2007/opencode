{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vercel": {
      "models": {
        "anthropic/claude-opus-4.8": {
          "name": "Claude Opus 4.8",
          "family": "claude-opus",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 5,
            "output": 25,
            "cache_read": 0.5
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    },
    "openrouter": {
      "models": {
        "anthropic/claude-opus-4.8-fast": {
          "name": "Claude Opus 4.8 (Fast)",
          "family": "claude-opus",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "cost": {
            "input": 10,
            "output": 50,
            "cache_read": 1,
            "cache_write": 12.5
          },
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "permission": {},
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
  "agent": {
    "refactor": {
      "mode": "subagent",
      "description": "Refactor and clean code writer. Use when code needs restructuring, readability improvements, dead code removal, or architectural cleanup."
    },
    "verifier": {
      "mode": "subagent",
      "description": "Code verifier and correctness critic. Use when code needs independent verification, contract checking, edge case analysis, or adversarial review."
    }
  },
}
